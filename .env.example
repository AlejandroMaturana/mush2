# ── Base Configuration (.env) ──────────────────────────────────────
# Load order (env.js):
#   1. .env          — base values shared across all environments
#   2. .env.{env}    — environment-specific overrides (wins over .env)
#
# This file is the TEMPLATE for .env (base layer).
# Only firmware and truly shared values go here.

# ── WIFI CREDENTIALS (firmware) ───────────────────────────────
WIFI_SSID_1=YourSSID1
WIFI_PASSWORD_1=YourPassword1
WIFI_SSID_2=YourSSID2
WIFI_PASSWORD_2=YourPassword2

# ── THINGSPEAK (firmware only) ────────────────────────────────
# TS_API_KEY=YourTSAPIKey
TS_HOST=api.thingspeak.com
TS_PORT=80

# ── DEVICE ID (firmware) ──────────────────────────────────────
DEVICE_ID=mush2_001

# ── Development (.env.development) ────────────────────────────
# NODE_ENV=development       # drives DB setting app_environment
# DB_USER=mush2_dev
# DB_HOST=localhost
# DB_NAME=mush2_dev
# DB_PASSWORD=mush2_dev_password
# DB_PORT=5433
# DATABASE_URL=postgresql://mush2_dev:mush2_dev_password@localhost:5433/mush2_dev
# JWT_SECRET=dev-secret-change-in-production
# MQTT_BROKER_URL=mqtt://localhost:1884
# MQTT_BROKER_USER=backend_bridge
# MQTT_BROKER_PASS=change_me
# CORS_ORIGIN=http://localhost:5173
# LOG_LEVEL=debug

# ── Production (.env.production) ──────────────────────────────
# In Render, these are set via the dashboard or render.yaml.
# DATABASE_URL is injected by the PostgreSQL addon.
#
# NODE_ENV=production
# PORT=3797
# JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
# CORS_ORIGIN=https://your-app.onrender.com
