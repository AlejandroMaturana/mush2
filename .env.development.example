# ── Development Environment (ADR-029) ─────────────────────────────
# Create your local copy: cp .env.development.example .env.development
# NEVER commit .env.development to Git.
#
# These values are safe defaults for local development.
# Override sensitive values (PASSWORD, SECRET, PASS) after copying.

# ── Environment ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3797

# ── Database (Docker Dev Stack — port 5433) ───────────────────────
DB_USER=mush2_dev
DB_HOST=localhost
DB_NAME=mush2_dev
DB_PASSWORD=change_me_dev_password
DB_PORT=5433
DATABASE_URL=postgresql://mush2_dev:change_me_dev_password@localhost:5433/mush2_dev

# ── Security ──────────────────────────────────────────────────────
JWT_SECRET=change-me-dev-secret

# ── MQTT (Docker Dev Stack — port 1884) ───────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1884
MQTT_BROKER_USER=backend_bridge
MQTT_BROKER_PASS=change_me_dev_mqtt

# ── MQTT Provisioning (container name for docker restart) ─────────
MOSQUITTO_CONTAINER=mush2-dev-mosquitto
MOSQUITTO_PASSWORD_FILE=docker/mosquitto/dev/password_file

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=debug
