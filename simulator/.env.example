# ── Protocol Simulator (FASE 1) — Variables de entorno ────────────
# Copiar a .env para sobrescribir defaults de desarrollo.

# Identidad del dispositivo virtual
SIM_DEVICE_ID=sim_001

# Broker MQTT (dev: mosquitto en docker-compose.dev.yml mapea 1884:1883)
SIM_BROKER_URL=mqtt://localhost:1884

# API del backend (registro ADR-028)
SIM_API_URL=http://localhost:3797/api/v1

# Intervalo de publicación de telemetría (ms)
SIM_TELEMETRY_INTERVAL_MS=10000

# Modo de telemetría: drift (random walk) | fixed (determinístico)
SIM_TELEMETRY_MODE=drift

# Semilla para el PRNG en modo drift (determinístico por seed)
SIM_SEED=12345

# Prefijo de tópicos canónicos (coincide con TOPIC_PREFIX del backend)
SIM_TOPIC_PREFIX=mush2

# Credenciales MQTT persistidas (obtenidas vía /devices/register).
# Si se omiten y no existe el archivo de credenciales, el simulador se
# registra contra SIM_API_URL y persiste el resultado.
SIM_MQTT_USER=
SIM_MQTT_PASS=

# Archivo donde persistir las credenciales provisionadas (ADR-028)
SIM_CREDENTIALS_FILE=.sim-credentials.json
