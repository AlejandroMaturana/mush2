# ── Test Environment ──────────────────────────────────────────────
# Loaded when NODE_ENV=test (local or CI).
# Values may be overridden by CI environment variables.
#
# Copy to .env.test only when running tests with a local configuration:
#   cp .env.test.example .env.test

NODE_ENV=test
PORT=3798

# ── Database ──────────────────────────────────────────────────────
# CI provides its own PostgreSQL via GitHub Actions service.
# Locally, ensure a test DB is available or use SQLite fallback.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mush2_test
DB_PASSWORD=postgres
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mush2_test

# ── Security ──────────────────────────────────────────────────────
JWT_SECRET=test-secret-not-used-in-production

# ── MQTT ──────────────────────────────────────────────────────────
# Tests should NOT connect to a real broker.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_USER=test_bridge
MQTT_BROKER_PASS=test_mqtt_password

# ── MQTT Provisioning ─────────────────────────────────────────────
MOSQUITTO_CONTAINER=
MOSQUITTO_PASSWORD_FILE=docker/mosquitto/test/password_file

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=silent
