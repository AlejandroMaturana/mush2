{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mush2 ACK",
  "description": "Reconocimiento de comando canónico publicado en mush2/{deviceId}/ack (ADR-030)",
  "type": "object",
  "required": ["cmdId", "channel", "state", "status", "ts"],
  "properties": {
    "cmdId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v4 del comando reconocido (ADR-030 §2)"
    },
    "channel": { "type": "integer", "minimum": 1, "maximum": 4 },
    "state": {
      "anyOf": [
        { "type": "integer", "enum": [0, 1] },
        { "type": "string", "enum": ["ON", "OFF"] }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "DELIVERED", "COMPLETED", "FAILED", "EXPIRED", "ACKED", "TIMEOUT"]
    },
    "ts": { "type": "integer", "minimum": 0, "maximum": 4102444800, "description": "Timestamp Unix en segundos (ADR-026)" }
  },
  "additionalProperties": true
}
